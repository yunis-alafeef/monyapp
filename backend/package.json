{
  "name": "hisabati-backend",
  "version": "1.0.0",
  "description": "Hisabati Arabic Debt & Ledger Backend API (PostgreSQL + Firebase Auth + WhatsApp Cloud API + SMS Gateway)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
